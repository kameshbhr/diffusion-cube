# Cube connector settings. Copy to .env and fill in. Use a DEVELOPMENT
# Supabase project, never production. `mcp-use dev`/`start` load .env.

# Project ref, from Project Settings -> General (same project as the Cube app).
MCP_USE_OAUTH_SUPABASE_PROJECT_ID=your-dev-project-ref
# Optional: full project URL instead of the ref (e.g. for a custom domain).
# MCP_USE_OAUTH_SUPABASE_URL=https://your-dev-project-ref.supabase.co

# Only if the project still signs tokens with the legacy HS256 secret (new
# projects use ES256 + JWKS and need nothing here):
# MCP_USE_OAUTH_SUPABASE_JWT_SECRET=

# Service-role key (or sb_secret_...). Stays on this server: it reads and
# writes the cube_* tables and looks up who is calling. Never give it to
# Claude or put it in a skill.
SUPABASE_SERVICE_ROLE_KEY=

# The connector's public address: origin only, NO /mcp on the end (the MCP
# endpoint is this + /mcp). Required when deployed; leave unset locally.
# MCP_URL=https://cube-connector.example.org

# Email domain(s) allowed to use the connector, comma-separated. Keep in step
# with NEXT_PUBLIC_CUBE_ALLOWED_DOMAINS in the Cube app's env.
CUBE_ALLOWED_DOMAINS=ekstep.org

# Claude API key, used only by this server to structure raw notes. Without
# it (or if a call fails), notes are still saved, as 'unstructured'; re-run
# them later with `npm run restructure`.
ANTHROPIC_API_KEY=
# Model for structuring. Default claude-opus-5-5; claude-haiku-5-5 is much
# cheaper and faster if its results are good enough.
# CUBE_STRUCTURING_MODEL=claude-opus-5-5

# Time zone for reading plain dates ("2026-11-13", "today") as the start of day.
CUBE_TIME_ZONE=Asia/Kolkata

# Port. 3000 is taken by the Cube app's `next dev`.
PORT=3100
# When deployed: HOST=0.0.0.0
